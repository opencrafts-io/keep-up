# Copy to .env and fill in per environment: `cp .env.example .env`
#
# None of these have a default in code. Which values this file carries is the
# only difference between a QA deployment and a production one, so a missing
# entry fails loudly at startup rather than silently reaching for prod.
#
# .env is gitignored. Keep it that way, and never put real secrets here.


# --- Verisafe ---------------------------------------------------------------

# Base url of the Verisafe instance for THIS environment, no trailing path.
# Production is https://verisafe.opencrafts.io; point QA at its own host.
VERISAFE_BASE_URL=

# Service token (vst_...) sent as the X-API-Key header on service-to-service
# calls. Its bot account must hold the `oauth-token-broker` role, or every
# token request comes back 403 with no `error` field. Verisafe shows the raw
# token once at creation, so losing it means rotating.
VERISAFE_API_KEY=

# HS256 shared secret used to verify user JWTs that Verisafe issued.
VERISAFE_API_SECRET=

# Optional. Seconds before a Verisafe call gives up, and how many times a 503
# or connection failure is retried with backoff.
VERISAFE_TIMEOUT=10
VERISAFE_RETRIES=2


# --- Database ---------------------------------------------------------------

# Postgres. The test suite creates and drops test_<DB_NAME> against this same
# server, so the user needs CREATEDB.
DB_NAME=keepdb
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432


# --- Google -----------------------------------------------------------------

# Used only by agenda/views.py, which still builds Google credentials from a
# user's refresh token. The token broker replaces that; once agenda moves over,
# this service stops holding Google client credentials at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- RabbitMQ ---------------------------------------------------------------

# Broker for Celery and for the Verisafe user event consumer.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
